  },
  "fonts": {
    "body": "Atkinson Hyperlegible Next",
    "code": "Atkinson Hyperlegible Mono",
    "headingWeight": "bold",
    "headings": "Atkinson Hyperlegible Next"
  },
  "name": "Legible"
}
