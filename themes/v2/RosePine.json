      "function": {
        "dark": "#EBBCBA",
        "light": "#BE413B"
      },
      "keyword": {
        "dark": "#3D90B1",
        "light": "#286983"
      },
      "number": {
        "dark": "#F6C177",
        "light": "#995F10"
      },
      "string": {
        "dark": "#F6C177",
        "light": "#995F10"
      },
      "type": {
        "dark": "#9CCFD8",
        "light": "#44757E"
      }
    },
    "tertiary": {
      "dark": "#706C89",
      "light": "#888297"
    }
  },
  "fonts": {
    "body": "Crimson Pro",
    "code": "IBM Plex Mono",
    "headingWeight": "semibold",
